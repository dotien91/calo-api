    "@types/express": "^4.17.13",
    "@types/jest": "27.5.0",
    "@types/node": "^20.8.5",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "bull": "^4.11.4",
