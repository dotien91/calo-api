{
  "type": "mongodb",
  "host": "localhost",
  "port": 27017,
  "database": "lgbtq_db",
  "synchronize": true,
  "logging": false,
  "entities": [
     "src/**/entity/**/*.ts"
  ],
  "migrations": [ "src/**/migration/**/*.ts"
  ],
  "subscribers": [ "src/**/subscriber/**/*.ts"
  ],
  "cli": {
     "entitiesDir": "src/**/entities", "migrationsDir": "src/**/migration", "subscribersDir": "src/**/subscriber"
  }
}
